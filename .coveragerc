[run]
branch = True
relative_files = True
omit =
    tests/*
    **/migrations/*
    **/__pycache__/*
    manage.py

[report]
# The floor for the whole suite: the 91% measured in October 2026 minus one
# point, so pruning tests cannot silently drop coverage (issue #528). In CI,
# the scan job in sonar.yml applies it with `coverage report` to the combined
# shard data (#692); locally, pytest-cov applies it in scripts/ci-local.sh.
fail_under = 90
