# Scripts and images run inside Linux containers. A Windows checkout with
# core.autocrlf=true would otherwise turn "#!/bin/sh" into "#!/bin/sh\r" and
# the container fails with "exec ...: no such file or directory".
*.sh text eol=lf
Dockerfile text eol=lf
ops/backup/Dockerfile text eol=lf
scripts/css_pins.env text eol=lf
static/src/vendor/** text eol=lf
static/vendor/** text eol=lf
