# Copy to a protected directory outside the checkout and replace every example value.
# This file contains no secrets; do not put the populated copy in the repository.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
POSTGRES_PASSWORD=replace-with-a-long-random-value

# One-time browser setup while no member exists. Leave unset until you are ready;
# the /setup/ page will explain that it is required. It stops working after the
# first member is created.
SETUP_CODE=replace-with-a-long-random-setup-code

# Optional replacement for finance/policy/default.md. File path, or a directory
# that contains privacy-policy.md. Publish with:
# python manage.py publish_privacy_policy
# python manage.py publish_privacy_policy --material
PRIVACY_POLICY_PATH=

# Optional Google sign-in. Leave both unset to keep password-only sign-in.
# Create an OAuth 2.0 Web client in Google Cloud Console (see docs/deployment.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Use the MagicDNS name shown by `tailscale status`, without https://.
DJANGO_ALLOWED_HOSTS=basement-pc.example-tailnet.ts.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://basement-pc.example-tailnet.ts.net

# Host loopback port consumed by `tailscale serve`.
APP_PORT=8000

# Absolute directory on the second local disk; use forward slashes on Windows.
BACKUP_DIR=D:/financial-planner-backups

# Fernet key for SimpleFIN access URLs and AI App tokens. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key means every member must reconnect SimpleFIN and AI backends. Ciphertext stays in backups.
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key

# Daily SimpleFIN sync in TZ (default 06:30 local). Five-field cron, same shape as BACKUP_CRON.
SIMPLEFIN_SYNC_CRON=30 6 * * *

# Quiet window for background jobs on the local tower model (HH:MM-HH:MM in TZ).
# Jobs on local never wake the model; they run when it is already loaded or inside this window.
AI_LOCAL_QUIET_WINDOW=22:00-06:00
AI_JOB_POLL_SECONDS=15

# Empty dedicated Agent Harness project used for local sessions until app-tools-only
# sessions land. Hosted backends stay listed but unavailable unless this is true.
AGENT_HARNESS_PROJECT=financial-planner
AGENT_HARNESS_HOSTED_SESSIONS=false

# Nightly at 2:00 AM in the configured time zone; retain 14 nightly and 8 weekly.
BACKUP_CRON=0 2 * * *
TZ=America/New_York
NIGHTLY_RETENTION=14
WEEKLY_RETENTION=8

POSTGRES_DB=financial_planner
POSTGRES_USER=financial_planner
POSTGRES_VOLUME_NAME=financial-planner-postgres-data
