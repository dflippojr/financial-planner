# Copy to a protected directory outside the checkout and replace every example value.
# This file contains no secrets; do not put the populated copy in the repository.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
POSTGRES_PASSWORD=replace-with-a-long-random-value

# One-time browser setup while no member exists. Leave unset until you are ready;
# the /setup/ page will explain that it is required. It stops working after the
# first member is created.
SETUP_CODE=replace-with-a-long-random-setup-code

# Optional replacement for finance/policy/default.md. File path, or a directory
# that contains privacy-policy.md. Publish with:
# python manage.py publish_privacy_policy
# python manage.py publish_privacy_policy --material
PRIVACY_POLICY_PATH=

# Optional Google sign-in. Leave both unset to keep password-only sign-in.
# Create an OAuth 2.0 Web client in Google Cloud Console (see docs/deployment.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Use the MagicDNS name shown by `tailscale status`, without https://.
DJANGO_ALLOWED_HOSTS=basement-pc.example-tailnet.ts.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://basement-pc.example-tailnet.ts.net

# Host loopback port consumed by `tailscale serve`.
APP_PORT=8000

# Absolute directory on the second local disk; use forward slashes on Windows.
BACKUP_DIR=D:/financial-planner-backups

# Optional named volume for receipt files. Leave unset for the default name.
# RECEIPTS_VOLUME_NAME=financial-planner-receipts

# Fernet key for SimpleFIN access URLs and AI App tokens. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key means every member must reconnect SimpleFIN and AI backends. Ciphertext stays in backups.
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key

# Daily SimpleFIN sync in TZ (default 06:30 local). Five-field cron, same shape as BACKUP_CRON.
SIMPLEFIN_SYNC_CRON=30 6 * * *

# Quiet window for background jobs on the local tower model (HH:MM-HH:MM in TZ).
# Jobs on local never wake the model; they run when it is already loaded or inside this window.
AI_LOCAL_QUIET_WINDOW=22:00-06:00
AI_JOB_POLL_SECONDS=2
# Batch workers are capped at 3, independently of the chat pool below.
AI_JOB_WORKERS=3
AI_JOB_MAX_ATTEMPTS=5
AI_SHARED_LOCAL_DAILY_CAP=200
# A job whose harness session is still open is checked again after this delay without
# spending an attempt, and fails once the job is older than the maximum age.
AI_JOB_RESUME_DELAY_SECONDS=300
AI_JOB_RESUME_MAX_AGE_SECONDS=86400
# Chat turns run on their own lane in the background container: it polls every
# AI_CHAT_POLL_SECONDS, answers up to AI_CHAT_WORKERS turns at once, and fails a
# turn whose runner sent no heartbeat for AI_CHAT_STALE_SECONDS.
AI_CHAT_POLL_SECONDS=1
AI_CHAT_WORKERS=4
AI_CHAT_STALE_SECONDS=60
# Per-member limits on the shared lanes: unanswered chat turns, unexpired
# conversations, and queued monthly-review/unusual-spending phrasing jobs. A claimed
# chat turn fails after AI_CHAT_TURN_MAX_SECONDS even while its runner is alive
# (default: session timeout plus the stale-job margin).
AI_CHAT_MAX_PENDING_PER_MEMBER=3
AI_CHAT_MAX_CONVERSATIONS=50
# AI_CHAT_TURN_MAX_SECONDS=720
AI_JOB_MAX_QUEUED_PER_MEMBER=12

# Empty dedicated Agent Harness project used for local sessions until app-tools-only
# sessions land. Hosted backends stay listed but unavailable unless this is true.
AGENT_HARNESS_PROJECT=financial-planner
AGENT_HARNESS_HOSTED_SESSIONS=false
AGENT_HARNESS_SESSION_TIMEOUT_SECONDS=600
# Extra age on top of the session timeout before a running job is treated as abandoned.
AGENT_HARNESS_STALE_JOB_MARGIN_SECONDS=120

# Nightly at 2:00 AM in the configured time zone; retain 14 nightly and 8 weekly.
BACKUP_CRON=0 2 * * *
TZ=America/New_York
NIGHTLY_RETENTION=14
WEEKLY_RETENTION=8
# Restore the newest dump into a throwaway database every 7 days; 0 turns it off.
RESTORE_CHECK_INTERVAL_DAYS=7

# Comma-separated usernames who receive backup health alerts. Empty uses the
# earliest-created member.
OPERATOR_USERNAMES=

# Optional encrypted off-site copy. Set both remotes to enable; leave both empty to skip.
# Point OFFSITE_RCLONE_CONFIG at a real rclone.conf outside the checkout. Compose
# mounts only that file, read-only. Keep the matching age private key in a
# password manager, never on the tower.
OFFSITE_RCLONE_CONFIG=./ops/backup/rclone.conf.example
OFFSITE_RCLONE_REMOTE=
OFFSITE_AGE_RECIPIENT=

POSTGRES_DB=financial_planner
POSTGRES_USER=financial_planner
POSTGRES_VOLUME_NAME=financial-planner-postgres-data

# General metadata-only audit retention; one bounded purge per daily pass.
AUDIT_RETENTION_DAYS=90
AUDIT_PURGE_BATCH_SIZE=1000
